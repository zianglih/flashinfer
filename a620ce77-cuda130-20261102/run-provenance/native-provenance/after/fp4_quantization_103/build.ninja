ninja_required_version = 1.3
name = fp4_quantization_103
cuda_home = /usr/local/cuda
cxx = c++
nvcc = $cuda_home/bin/nvcc
cxx_launcher = 
nvcc_launcher = 

common_cflags = -DPy_LIMITED_API=0x03090000 $
    -D_GLIBCXX_USE_CXX11_ABI=1 $
    -I/data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/csrc/nv_internal $
    -I/data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/csrc/nv_internal/include $
    -I/data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/3rdparty/cccl/cub $
    -I/data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/3rdparty/cccl/libcudacxx/include $
    -I/data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/3rdparty/cccl/thrust $
    -isystem /usr/include/python3.12 $
    -isystem $cuda_home/include $
    -isystem /data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/venv/lib/python3.12/site-packages/tvm_ffi/include $
    -isystem /data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/venv/lib/python3.12/site-packages/tvm_ffi/include $
    -isystem /data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/include $
    -isystem /data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/csrc $
    -isystem /data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/3rdparty/cutlass/include $
    -isystem /data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/3rdparty/cutlass/tools/util/include $
    -isystem /data/ziangli/flashinfer-moe-gather-pipeline/cuda130-w4a16-20261102/payload/sources/after/3rdparty/spdlog/include
cflags = $common_cflags $
    -fPIC $
    -std=c++17 $
    -Wno-switch-bool $
    -DNDEBUG $
    -O3 $
    -DENABLE_BF16 $
    -DENABLE_FP8 $
    -DENABLE_FP4
post_cflags =
cuda_cflags = $common_cflags $
    --compiler-options=-fPIC $
    --expt-relaxed-constexpr $
    -static-global-template-stub=false $
    -DFLASHINFER_ENABLE_FP8_E8M0 $
    -DFLASHINFER_ENABLE_FP4_E2M1 $
    -std=c++17 $
    --threads=1 $
    -use_fast_math $
    -Xfatbin=-compress-all $
    --compress-mode=size $
    -DFLASHINFER_ENABLE_F16 $
    -DFLASHINFER_ENABLE_BF16 $
    -DFLASHINFER_ENABLE_FP8_E4M3 $
    -DFLASHINFER_ENABLE_FP8_E5M2 $
    -DNDEBUG $
    -O3 $
    -gencode=arch=compute_103a,code=sm_103a $
    -DFLASHINFER_ENABLE_FP8_E8M0 $
    -DFLASHINFER_ENABLE_FP4_E2M1 $
    -DENABLE_BF16 $
    -DENABLE_FP8 $
    -DENABLE_FP4
cuda_post_cflags =
cuda_arch_flags = -gencode=arch=compute_103a,code=sm_103a
ldflags = -shared $
    -L$cuda_home/lib64 $
    -L$cuda_home/lib64/stubs $
    -lcudart $
    -lcuda

rule compile
  command = $cxx_launcher $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc_launcher $nvcc --generate-dependencies-with-compile -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags
  depfile = $out.d
  deps = gcc

rule link
  command = $cxx $in $ldflags -o $out

